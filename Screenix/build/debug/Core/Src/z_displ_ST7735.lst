1070:Core/Src/z_displ_ST7735.c ****  * @param	cmd	'S'		put display in stby (light level=BKLIT_STBY_LEVEL)
1071:Core/Src/z_displ_ST7735.c ****  * 				'W' 	wake-up from stdby restoring previous level
1072:Core/Src/z_displ_ST7735.c ****  *				'+'		add 1 step to the current light level
1073:Core/Src/z_displ_ST7735.c ****  *				'-'		reduce 1 step to the current light level
1074:Core/Src/z_displ_ST7735.c ****  *				'F','1'	set the display level to max
