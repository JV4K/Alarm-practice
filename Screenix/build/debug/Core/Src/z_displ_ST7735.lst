 106:Core/Src/z_displ_ST7735.c **** init_cmds1[] = {            // Init for 7735R, part 1 (red or green tab)
 107:Core/Src/z_displ_ST7735.c ****   15,                       // 15 commands in list:
 108:Core/Src/z_displ_ST7735.c ****   ST7735_SWRESET,   DELAY,  //  1: Software reset, 0 args, w/delay
 109:Core/Src/z_displ_ST7735.c ****     150,                    //     150 ms delay
 110:Core/Src/z_displ_ST7735.c ****   ST7735_SLPOUT ,   DELAY,  //  2: Out of sleep mode, 0 args, w/delay
 111:Core/Src/z_displ_ST7735.c ****   ST7735_FLAG_LONG_DELAY,       //     500 ms delay
 112:Core/Src/z_displ_ST7735.c ****   ST7735_FRMCTR1, 3      ,  //  3: Frame rate ctrl - normal mode, 3 args:
 113:Core/Src/z_displ_ST7735.c ****     0x01, 0x2C, 0x2D,       //     Rate = fosc/(1x2+40) * (LINE+2C+2D)
 114:Core/Src/z_displ_ST7735.c ****   ST7735_FRMCTR2, 3      ,  //  4: Frame rate control - idle mode, 3 args:
 115:Core/Src/z_displ_ST7735.c ****     0x01, 0x2C, 0x2D,       //     Rate = fosc/(1x2+40) * (LINE+2C+2D)
 116:Core/Src/z_displ_ST7735.c ****   ST7735_FRMCTR3, 6      ,  //  5: Frame rate ctrl - partial mode, 6 args:
 117:Core/Src/z_displ_ST7735.c ****     0x01, 0x2C, 0x2D,       //     Dot inversion mode
 118:Core/Src/z_displ_ST7735.c ****     0x01, 0x2C, 0x2D,       //     Line inversion mode
 119:Core/Src/z_displ_ST7735.c ****   ST7735_INVCTR , 1      ,  //  6: Display inversion ctrl, 1 arg, no delay:
 120:Core/Src/z_displ_ST7735.c ****     0x07,                   //     No inversion
 121:Core/Src/z_displ_ST7735.c ****   ST7735_PWCTR1 , 3      ,  //  7: Power control, 3 args, no delay:
 122:Core/Src/z_displ_ST7735.c ****     0xA2,
 123:Core/Src/z_displ_ST7735.c ****     0x02,                   //     -4.6V
 124:Core/Src/z_displ_ST7735.c ****     0x84,                   //     AUTO mode
 125:Core/Src/z_displ_ST7735.c ****   ST7735_PWCTR2 , 1      ,  //  8: Power control, 1 arg, no delay:
 126:Core/Src/z_displ_ST7735.c ****     0xC5,                   //     VGH25 = 2.4C VGSEL = -10 VGH = 3 * AVDD
 127:Core/Src/z_displ_ST7735.c ****   ST7735_PWCTR3 , 2      ,  //  9: Power control, 2 args, no delay:
 128:Core/Src/z_displ_ST7735.c ****     0x0A,                   //     Opamp current small
 129:Core/Src/z_displ_ST7735.c ****     0x00,                   //     Boost frequency
 130:Core/Src/z_displ_ST7735.c ****   ST7735_PWCTR4 , 2      ,  // 10: Power control, 2 args, no delay:
 131:Core/Src/z_displ_ST7735.c ****     0x8A,                   //     BCLK/2, Opamp current small & Medium low
 132:Core/Src/z_displ_ST7735.c ****     0x2A,
 133:Core/Src/z_displ_ST7735.c ****   ST7735_PWCTR5 , 2      ,  // 11: Power control, 2 args, no delay:
 134:Core/Src/z_displ_ST7735.c ****     0x8A, 0xEE,
 135:Core/Src/z_displ_ST7735.c ****   ST7735_VMCTR1 , 1      ,  // 12: Power control, 1 arg, no delay:
 136:Core/Src/z_displ_ST7735.c ****     0x0E,
 137:Core/Src/z_displ_ST7735.c ****   ST7735_INVOFF , 0      ,  // 13: Don't invert display, no args, no delay
 138:Core/Src/z_displ_ST7735.c ****   ST7735_COLMOD , 1      ,  // 15: set color mode, 1 arg, no delay:
 139:Core/Src/z_displ_ST7735.c ****     0x05 },                 //     16-bit color
